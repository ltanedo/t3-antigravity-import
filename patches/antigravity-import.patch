diff --git a/apps/server/src/project/AntigravitySessionReader.ts b/apps/server/src/project/AntigravitySessionReader.ts
new file mode 100644
index 00000000..9ec82cf5
--- /dev/null
+++ b/apps/server/src/project/AntigravitySessionReader.ts
@@ -0,0 +1,137 @@
+import * as NodeSqliteClient from "@t3tools/shared/nodeSqliteClient";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Schema from "effect/Schema";
+import * as SqlClient from "effect/sql/SqlClient";
+import {
+  decodeAntigravityMessage,
+  decodeAntigravityWorkspace,
+  decodeAntigravityTrajectory,
+} from "./AntigravityTranscript.ts";
+
+class AntigravityTranscriptError extends Schema.TaggedError<AntigravityTranscriptError>()(
+  "AntigravityTranscriptError",
+  { path: Schema.String, cause: Schema.Defect() },
+) {
+  override get message() {
+    return `Could not read Antigravity history from ${this.path}.`;
+  }
+}
+
+const MAX_STEP_BYTES = 16 * 1024 * 1024;
+const MAX_TEXT_BYTES = 32 * 1024 * 1024;
+const MAX_STEPS = 100_000;
+const decodeTrajectoryJson = Schema.decodeEffect(Schema.fromJsonString(Schema.Unknown));
+
+const read = Effect.fn("AntigravitySessionReader.read")(function* (
+  path: string,
+  metadataOnly: boolean,
+) {
+  const sql = yield* SqlClient.SqlClient;
+  const decode = <A>(f: () => A) =>
+    Effect.try({
+      try: f,
+      catch: (cause) => new AntigravityTranscriptError({ path, cause }),
+    });
+  yield* sql.unsafe("PRAGMA busy_timeout = 1000");
+  return yield* Effect.gen(function* () {
+    const meta = yield* sql.unsafe<{ data: Uint8Array }>(
+      "SELECT data FROM trajectory_metadata_blob WHERE id = 'main' AND length(data) <= ?",
+      [MAX_STEP_BYTES],
+    );
+    if (meta.length !== 1)
+      return yield* decode(() => {
+        throw new Error("Missing trajectory metadata");
+      });
+    const workspace = yield* decode(() => decodeAntigravityWorkspace(meta[0]!.data));
+    const identity = yield* sql.unsafe<{ cascade_id: string }>(
+      "SELECT cascade_id FROM trajectory_meta LIMIT 2",
+    );
+    if (identity.length !== 1 || !/^[0-9a-f-]{36}$/i.test(identity[0]!.cascade_id)) {
+      return yield* decode(() => {
+        throw new Error("Invalid trajectory identity");
+      });
+    }
+    const messages: Array<{ role: "user" | "assistant"; text: string; createdAt: string }> = [];
+    let attachmentMessages = 0;
+    let bytes = 0;
+    let stepCount = 0;
+    let after = -1;
+    if (!metadataOnly)
+      while (true) {
+        const rows = yield* sql.unsafe<{
+          idx: number;
+          step_type: number;
+          step_format: number;
+          step_payload: Uint8Array | null;
+          metadata: Uint8Array | null;
+        }>(
+          `SELECT idx, step_type, step_format,
+        CASE WHEN length(step_payload) <= ? THEN step_payload ELSE NULL END AS step_payload,
+        CASE WHEN length(metadata) <= ? THEN metadata ELSE NULL END AS metadata
+        FROM steps WHERE idx > ? ORDER BY idx LIMIT 32`,
+          [MAX_STEP_BYTES, MAX_STEP_BYTES, after],
+        );
+        for (const row of rows) {
+          if (++stepCount > MAX_STEPS)
+            return yield* decode(() => {
+              throw new Error("Antigravity step limit exceeded");
+            });
+          const message = yield* decode(() => decodeAntigravityMessage(row));
+          if (!message) continue;
+          const createdAt = message.createdAt ?? workspace.createdAt;
+          if (createdAt === null)
+            return yield* decode(() => {
+              throw new Error("Missing message timestamp");
+            });
+          if (message.hasAttachments) attachmentMessages++;
+          const text =
+            message.text +
+            (message.hasAttachments
+              ? "\n\n[Attachment present in the original Antigravity conversation; attachment data was not imported.]"
+              : "");
+          bytes += Buffer.byteLength(text, "utf8");
+          if (bytes > MAX_TEXT_BYTES)
+            return yield* decode(() => {
+              throw new Error("Antigravity history exceeds the 32 MiB import limit");
+            });
+          messages.push({ role: message.role, text, createdAt });
+        }
+        if (rows.length < 32) break;
+        after = rows[rows.length - 1]!.idx;
+      }
+    return {
+      ...workspace,
+      sessionId: identity[0]!.cascade_id,
+      messages,
+      attachmentMessages,
+      stepCount,
+      title: "",
+    };
+  }).pipe(sql.withTransaction);
+});
+
+export const readAntigravitySession = Effect.fn("readAntigravitySession")(function* (
+  path: string,
+  metadataOnly = false,
+) {
+  if (path.endsWith(".trajectory.json")) {
+    const fs = yield* FileSystem.FileSystem;
+    const stat = yield* fs.stat(path);
+    if (stat.size > BigInt(128 * 1024 * 1024)) {
+      return yield* new AntigravityTranscriptError({
+        path,
+        cause: new Error("Trajectory export exceeds 128 MiB"),
+      });
+    }
+    const contents = yield* fs.readFileString(path);
+    const value = yield* decodeTrajectoryJson(contents);
+    return yield* Effect.try({
+      try: () => decodeAntigravityTrajectory(value),
+      catch: (cause) => new AntigravityTranscriptError({ path, cause }),
+    });
+  }
+  return yield* read(path, metadataOnly).pipe(
+    Effect.provide(NodeSqliteClient.layer({ filename: path, readonly: true })),
+  );
+});
diff --git a/apps/server/src/project/AntigravityTranscript.ts b/apps/server/src/project/AntigravityTranscript.ts
new file mode 100644
index 00000000..9188ffab
--- /dev/null
+++ b/apps/server/src/project/AntigravityTranscript.ts
@@ -0,0 +1,199 @@
+import * as NodeURL from "node:url";
+import * as DateTime from "effect/DateTime";
+
+type Field = number | bigint | Uint8Array;
+type Fields = Map<number, Field[]>;
+
+function fields(bytes: Uint8Array): Fields {
+  let offset = 0;
+  const result: Fields = new Map();
+  const varint = () => {
+    let value = 0n;
+    for (let shift = 0n; shift < 70n; shift += 7n) {
+      const byte = bytes[offset++];
+      if (byte === undefined || (shift === 63n && byte > 1)) {
+        throw new Error("Invalid Antigravity protobuf varint");
+      }
+      value |= BigInt(byte & 127) << shift;
+      if (byte < 128) return value <= BigInt(Number.MAX_SAFE_INTEGER) ? Number(value) : value;
+    }
+    throw new Error("Invalid Antigravity protobuf varint");
+  };
+  while (offset < bytes.length) {
+    const tag = varint();
+    if (typeof tag !== "number" || tag < 8 || tag > 0xffffffff) {
+      throw new Error("Invalid Antigravity protobuf tag");
+    }
+    const key = Math.floor(tag / 8);
+    const wire = tag % 8;
+    let value: Field;
+    if (wire === 0) value = varint();
+    else if (wire === 1 || wire === 2 || wire === 5) {
+      const length = wire === 2 ? varint() : wire === 1 ? 8 : 4;
+      if (typeof length !== "number" || length > bytes.length - offset) {
+        throw new Error("Truncated Antigravity protobuf field");
+      }
+      value = bytes.subarray(offset, offset + length);
+      offset += length;
+      if (wire !== 2) continue;
+    } else throw new Error("Unsupported Antigravity protobuf wire type");
+    const entries = result.get(key) ?? [];
+    entries.push(value);
+    result.set(key, entries);
+  }
+  return result;
+}
+
+function blob(value: unknown): Uint8Array {
+  if (!(value instanceof Uint8Array)) throw new Error("Invalid Antigravity protobuf blob");
+  return value;
+}
+
+function nested(value: Fields, key: number): Fields {
+  const entry = value.get(key)?.[0];
+  return entry === undefined ? new Map() : fields(blob(entry));
+}
+
+function text(value: Fields, key: number): string {
+  const entry = value.get(key)?.[0];
+  return entry === undefined ? "" : new TextDecoder("utf-8", { fatal: true }).decode(blob(entry));
+}
+
+function timestamp(value: Fields): string | null {
+  const seconds = value.get(1)?.[0];
+  const nanos = value.get(2)?.[0] ?? 0;
+  if (seconds === undefined) return null;
+  if (typeof seconds !== "number" || typeof nanos !== "number" || nanos < 0 || nanos >= 1e9) {
+    throw new Error("Invalid Antigravity timestamp");
+  }
+  return DateTime.formatIso(DateTime.makeUnsafe(seconds * 1000 + Math.floor(nanos / 1e6)));
+}
+
+export function decodeAntigravityWorkspace(metadata: Uint8Array) {
+  const root = fields(metadata);
+  const uris = (root.get(7) ?? []).map((value) =>
+    new TextDecoder("utf-8", { fatal: true }).decode(blob(value)),
+  );
+  for (const workspace of root.get(1) ?? []) {
+    const uri = text(fields(blob(workspace)), 1);
+    if (uri) uris.push(uri);
+  }
+  return {
+    paths: [...new Set(uris.map((uri) => NodeURL.fileURLToPath(uri)))],
+    createdAt: timestamp(nested(root, 2)),
+  };
+}
+
+export function decodeAntigravityMessage(row: {
+  readonly step_type: number;
+  readonly step_format: number;
+  readonly step_payload: unknown;
+  readonly metadata: unknown;
+}) {
+  if (row.step_type !== 14 && row.step_type !== 15) return null;
+  if (row.step_format !== 0) throw new Error("Unsupported Antigravity step encoding");
+  const root = fields(blob(row.step_payload));
+  if (root.get(1)?.[0] !== row.step_type) throw new Error("Antigravity step type mismatch");
+  const payload = nested(root, row.step_type === 14 ? 19 : 20);
+  let content: string;
+  if (row.step_type === 14) {
+    content = text(payload, 2) || text(payload, 1);
+    if (!content) {
+      content = (payload.get(3) ?? [])
+        .map((item) => text(fields(blob(item)), 1))
+        .filter(Boolean)
+        .join("\n");
+    }
+  } else content = text(payload, 8) || text(payload, 1);
+  const hasAttachments = row.step_type === 14 && (payload.has(5) || payload.has(9));
+  if (!content.trim() && !hasAttachments) return null;
+  const metadata = row.metadata === null ? nested(root, 5) : fields(blob(row.metadata));
+  return {
+    role: row.step_type === 14 ? ("user" as const) : ("assistant" as const),
+    text: content,
+    createdAt: timestamp(nested(metadata, 1)),
+    hasAttachments,
+  };
+}
+
+function object(value: unknown): Record<string, unknown> {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) {
+    throw new Error("Invalid Antigravity trajectory object");
+  }
+  return value as Record<string, unknown>;
+}
+
+function string(value: unknown): string {
+  if (value === undefined) return "";
+  if (typeof value !== "string") throw new Error("Invalid Antigravity text");
+  return value;
+}
+
+function iso(value: unknown): string | null {
+  const text = string(value);
+  return text ? DateTime.formatIso(DateTime.makeUnsafe(text)) : null;
+}
+
+export function decodeAntigravityTrajectory(value: unknown) {
+  const root = object(value);
+  const sessionId = string(root.cascadeId);
+  if (!/^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(sessionId)) {
+    throw new Error("Invalid Antigravity conversation ID");
+  }
+  const metadata = object(root.metadata ?? {});
+  const imported = object(root.t3Import ?? {});
+  const workspaces = metadata.workspaces ?? [];
+  const steps = root.steps ?? [];
+  if (!Array.isArray(workspaces) || !Array.isArray(steps) || steps.length > 100_000) {
+    throw new Error("Invalid Antigravity trajectory collection");
+  }
+  const paths = workspaces.map((workspace) =>
+    NodeURL.fileURLToPath(string(object(workspace).workspaceFolderAbsoluteUri)),
+  );
+  const workspaceOverride = string(imported.workspaceRoot);
+  if (workspaceOverride) paths.splice(0, paths.length, workspaceOverride);
+  const createdAt = iso(metadata.createdAt);
+  const messages: Array<{ role: "user" | "assistant"; text: string; createdAt: string }> = [];
+  let attachmentMessages = 0;
+  let bytes = 0;
+  for (const value of steps) {
+    const step = object(value);
+    const user = step.type === "CORTEX_STEP_TYPE_USER_INPUT";
+    const assistant = step.type === "CORTEX_STEP_TYPE_PLANNER_RESPONSE";
+    const notification = step.type === "CORTEX_STEP_TYPE_NOTIFY_USER";
+    if (!user && !assistant && !notification) continue;
+    const payload = object(
+      user ? step.userInput : assistant ? step.plannerResponse : step.notifyUser,
+    );
+    const raw = user
+      ? string(payload.userResponse) || string(payload.query)
+      : assistant
+        ? string(payload.modifiedResponse) || string(payload.response)
+        : string(payload.notificationContent);
+    const hasAttachments =
+      user &&
+      [payload.images, payload.media].some((items) => Array.isArray(items) && items.length > 0);
+    if (!raw.trim() && !hasAttachments) continue;
+    const text =
+      raw +
+      (hasAttachments
+        ? "\n\n[Attachment present in the original Antigravity conversation; attachment data was not imported.]"
+        : "");
+    if (hasAttachments) attachmentMessages++;
+    bytes += Buffer.byteLength(text, "utf8");
+    if (bytes > 32 * 1024 * 1024)
+      throw new Error("Antigravity history exceeds the 32 MiB import limit");
+    const at = iso(object(step.metadata ?? {}).createdAt) ?? createdAt;
+    if (at === null) throw new Error("Missing Antigravity message timestamp");
+    messages.push({ role: user ? "user" : "assistant", text, createdAt: at });
+  }
+  return {
+    sessionId,
+    paths: [...new Set(paths)],
+    createdAt,
+    messages,
+    attachmentMessages,
+    stepCount: steps.length,
+    title: string(imported.title),
+  };
+}
diff --git a/apps/server/src/project/AntigravityTranscript.test.ts b/apps/server/src/project/AntigravityTranscript.test.ts
new file mode 100644
index 00000000..8b487917
--- /dev/null
+++ b/apps/server/src/project/AntigravityTranscript.test.ts
@@ -0,0 +1,119 @@
+import * as NodeURL from "node:url";
+import { describe, expect, it } from "vite-plus/test";
+import {
+  decodeAntigravityMessage,
+  decodeAntigravityWorkspace,
+  decodeAntigravityTrajectory,
+} from "./AntigravityTranscript.ts";
+
+function varint(value: number): number[] {
+  const bytes: number[] = [];
+  do {
+    const byte = value % 128;
+    value = Math.floor(value / 128);
+    bytes.push(byte | (value ? 128 : 0));
+  } while (value);
+  return bytes;
+}
+
+function message(...entries: [number, number | string | Uint8Array][]): Uint8Array {
+  return Uint8Array.from(
+    entries.flatMap(([key, value]) => {
+      if (typeof value === "number") return [...varint(key * 8), ...varint(value)];
+      const bytes = typeof value === "string" ? new TextEncoder().encode(value) : value;
+      return [...varint(key * 8 + 2), ...varint(bytes.length), ...bytes];
+    }),
+  );
+}
+
+const metadata = message([1, message([1, 1700000000], [2, 123000000])]);
+const row = (type: number, payload: Uint8Array) => ({
+  step_type: type,
+  step_format: 0,
+  metadata,
+  step_payload: message([1, type], [type === 14 ? 19 : 20, payload]),
+});
+
+describe("Antigravity transcript decoding", () => {
+  it("preserves user text once, timestamps, and attachment presence", () => {
+    const decoded = decodeAntigravityMessage(
+      row(
+        14,
+        message(
+          [2, "  Explain λ\nnext line  "],
+          [3, message([1, "duplicate representation"])],
+          [9, message([1, "image"])],
+        ),
+      ),
+    );
+    expect(decoded).toEqual({
+      role: "user",
+      text: "  Explain λ\nnext line  ",
+      createdAt: "2023-11-14T22:13:20.123Z",
+      hasAttachments: true,
+    });
+  });
+
+  it("uses the displayed response and excludes thinking and tool-only replies", () => {
+    expect(
+      decodeAntigravityMessage(
+        row(15, message([1, "raw response"], [8, "displayed response"], [3, "internal reasoning"])),
+      )?.text,
+    ).toBe("displayed response");
+    expect(
+      decodeAntigravityMessage(row(15, message([3, "thinking"], [7, message([1, "tool"])]))),
+    ).toBeNull();
+    expect(decodeAntigravityMessage({ ...row(21, message()), step_payload: null })).toBeNull();
+  });
+
+  it("rejects corrupt blobs, mismatched types, and unsupported encodings", () => {
+    expect(() =>
+      decodeAntigravityMessage({ ...row(14, message()), step_payload: Uint8Array.of(0x9a, 1, 20) }),
+    ).toThrow();
+    expect(() => decodeAntigravityMessage({ ...row(14, message()), step_type: 15 })).toThrow(
+      /mismatch/,
+    );
+    expect(() => decodeAntigravityMessage({ ...row(14, message()), step_format: 1 })).toThrow(
+      /encoding/,
+    );
+    expect(() => decodeAntigravityMessage(row(14, message([2, Uint8Array.of(255)])))).toThrow();
+  });
+
+  it("decodes and deduplicates workspace URIs without splitting paths with spaces", () => {
+    const cwd = NodeURL.fileURLToPath(
+      new URL("workspace%20with%20spaces", NodeURL.pathToFileURL(process.cwd() + "/")),
+    );
+    const uri = NodeURL.pathToFileURL(cwd).href;
+    expect(
+      decodeAntigravityWorkspace(
+        message([7, uri], [1, message([1, uri])], [2, message([1, 1700000000])]),
+      ),
+    ).toEqual({ paths: [cwd], createdAt: "2023-11-14T22:13:20.000Z" });
+    expect(() => decodeAntigravityWorkspace(message([7, "https://example.com"]))).toThrow();
+  });
+});
+
+it("decodes legacy JSON exports, preserves attachment-only turns, and rejects invalid identities", () => {
+  const input = {
+    cascadeId: "11111111-1111-4111-8111-111111111111",
+    metadata: { createdAt: "2026-01-01T00:00:00Z" },
+    t3Import: { workspaceRoot: process.cwd(), title: "Legacy chat" },
+    steps: [
+      { type: "CORTEX_STEP_TYPE_USER_INPUT", userInput: { media: [{ mimeType: "image/png" }] } },
+      {
+        type: "CORTEX_STEP_TYPE_PLANNER_RESPONSE",
+        plannerResponse: { response: "Image description", thinking: "private reasoning" },
+      },
+      { type: "CORTEX_STEP_TYPE_RUN_COMMAND", runCommand: { commandLine: "never execute this" } },
+    ],
+  };
+  const result = decodeAntigravityTrajectory(input);
+  expect(result.messages).toHaveLength(2);
+  expect(result.messages[0]?.role).toBe("user");
+  expect(result.messages[0]?.text).toContain("attachment data was not imported");
+  expect(result.messages[1]?.text).toBe("Image description");
+  expect(result.paths).toEqual([process.cwd()]);
+  expect(result.attachmentMessages).toBe(1);
+  expect(() => decodeAntigravityTrajectory({ ...input, cascadeId: "../invalid" })).toThrow();
+  expect(() => decodeAntigravityTrajectory({ ...input, steps: "invalid" })).toThrow();
+});
